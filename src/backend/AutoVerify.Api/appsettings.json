{
  "ApiServer": {
    "Host": "0.0.0.0",
    "Port": 5058,
    "EnableHttps": false,
    "HttpsPort": 7217,
    "CertificatePath": "",
    "CertificatePassword": "",
    "EnableSwagger": true,
    "EnableStaticFiles": true,
    "MaxRequestBodySizeMb": 256
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "LogDirectory": "logs",
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.DataProtection": "Information",
        "Pomelo.EntityFrameworkCore.MySql": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AutoVerify": "Server=localhost;Port=3306;Database=autoverify;User=root;Password=1111;CharSet=utf8mb4;Allow User Variables=True;"
  },
  "Database": {
    "ServerVersion": "10.6.0",
    "CommandTimeoutSeconds": 120,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10
  },
  "DatabaseBootstrap": {
    "Enabled": true,
    "ScriptPath": "Database/bootstrap.sql",
    "RunOnlyWhenDatabaseIsEmpty": true,
    "FailOnError": true,
    "CommandTimeoutSeconds": 300
  },
  "DataProtection": {
    "ApplicationName": "AutoVerify",
    "KeysPath": "",
    "ProtectKeysWithDpapi": true
  },
  "HttpClients": {
    "ImageCrawlerTimeoutSeconds": 30,
    "SeaweedFsTimeoutSeconds": 60
  },
  "ImageCrawler": {
    "AllowExternalUrls": false,
    "DefaultApiUrl": "http://10.121.45.43:336/api/image/get",
    "ImageRoot": "\\\\192.168.200.121\\d\\defectimage",
    "BatchMaxItems": 100
  },
  "BackgroundJobs": {
    "OverkillSchedulerIntervalSeconds": 60
  },
  "SeaweedFs": {
    "MasterUrl": "http://localhost:9333",
    "FilerUrl": "http://localhost:8888",
    "BaseUrl": "",
    "PublicBaseUrl": "http://localhost:8888",
    "DefaultBucket": "autoverify",
    "LocalFallbackPath": "data/storage",
    "OffloadDefects": true
  },
  "DefectPreview": {
    "MaxConcurrentIngestions": 2,
    "DefaultTtlMinutes": 120,
    "BatchInsertSize": 1000,
    "CleanupIntervalMinutes": 10,
    "DefaultPageSize": 50,
    "MaxPageSize": 200,
    "FeatureSnippetMaxLength": 500,
    "MaxRowsLimit": 50000,
    "EnableSafeJsonRecovery": true
  }
}
